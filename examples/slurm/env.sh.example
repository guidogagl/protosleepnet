#!/usr/bin/env bash
# Cluster-specific paths for the ProtoSleepNet SLURM launchers.
# Copy to `env.sh` (git-ignored) and edit for YOUR cluster, then each
# launcher does: `source "$(dirname "$0")/../env.sh"`.
#
# Also set your scheduler account in the #SBATCH --account=<SLURM_ACCOUNT>
# line at the top of each .sbatch (left as a placeholder on purpose).

# Where the physioex repo is checked out on the compute node
export PHYSIOEX_REPO="${PHYSIOEX_REPO:-$HOME/physioex}"
# Virtualenv activate script for the physioex environment
export PSN_VENV_ACTIVATE="${PSN_VENV_ACTIVATE:-$HOME/.venv/physioex/bin/activate}"
# physioex dataset cache + raw data
export PHYSIOEX_CACHE_DIR="${PHYSIOEX_CACHE_DIR:-$HOME/cache/physioex}"
export PHYSIOEX_DATA="${PHYSIOEX_DATA:-$HOME/data}"
# ProtoSleepNet work roots (checkpoints, results, logs)
export PSN_WORK="${PSN_WORK:-$HOME/work/protosleepnet}"
export PSN_SCRATCH="${PSN_SCRATCH:-$PSN_WORK/scratch}"
export PSN_PRETRAINED="${PSN_PRETRAINED:-$PSN_WORK/pretrained}"
export PSN_RESULTS="${PSN_RESULTS:-$PSN_WORK/results}"
export PSN_LOGS="${PSN_LOGS:-$PSN_WORK/logs}"
